# 复制为 .env 后填写。不要把真实 Key 提交进 git。
# DeepSeek: https://api.deepseek.com
#   推荐模型 deepseek-flash（对应 DeepSeek-V4.1-Flash）
#   旧名 deepseek-v4-flash / deepseek-chat 可能仍被路由，但不建议新配置继续用
# 阿里云百炼: https://dashscope.aliyuncs.com/compatible-mode/v1  模型 qwen-plus
# OpenAI: https://api.openai.com/v1  模型 gpt-4o-mini

LLM_API_KEY=sk-your-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# Day 10 默认用本地 BAAI/bge-small-zh-v1.5，不必填下面三项。
# 若以后改 API embedding，再填：
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-v3
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# Day 12：重排。cross= BAAI/bge-reranker-base；light= token Jaccard 兜底
RERANKER_BACKEND=cross
LOCAL_RERANKER_MODEL=BAAI/bge-reranker-base

MAX_STEPS=6
# 单次 LLM 请求超时（秒）；超时/限流会有限重试
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
# Day 14：整次 /ask 超时（秒）、问题最大字符数
ASK_TIMEOUT=120
MAX_QUESTION_CHARS=2000
LOG_LEVEL=INFO
